<mxCell id="a9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#4B5563;fontStyle=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="approve" target="ship"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#4B5563;fontStyle=0;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ship" target="recv"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a11" value="sold in the destination by FEFO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#4B5563;fontStyle=0;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0.0;exitDx=0;exitDy=0;entryX=0.5;entryY=1.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="recv" target="dispense"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#111827;fontStyle=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="decide" target="propose"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#4B5563;fontStyle=0;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="propose" target="approvewo"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#4B5563;fontStyle=0;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="approvewo" target="dash"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="a15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#374151;strokeWidth=1.8;fontSize=12;fontColor=#4B5563;fontStyle=0;labelBackgroundColor=#ffffff;exitX=0.0;exitY=0.5;exitDx=0;exitDy=0;entryX=1.0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dash" target="end"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="legend" value="&lt;b style='font-size:14px'&gt;Who acts&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='background:#EFF6FF;border:1px solid #2563EB;'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp; Manager of the source pharmacy&lt;br&gt;&lt;span style='background:#ECFDF5;border:1px solid #059669;'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp; Pharmacist of the source pharmacy&lt;br&gt;&lt;span style='background:#FFFBEB;border:1px solid #D97706;'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp; Destination pharmacy (manager or pharmacist)&lt;br&gt;&lt;span style='background:#F5F3FF;border:1px solid #7C3AED;'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&amp;nbsp; System (background job)&lt;br&gt;&lt;br&gt;&lt;span style='color:#4B5563'&gt;Not drawn: issue #3 is closed manually after this whole flow runs in one session on seeded data. The decision uses the suggestions from #17.&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12.5;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="50" y="330" width="720" height="220" as="geometry"/></mxCell>
</root>
