<mxfile host="app.diagrams.net" type="device">
<diagram id="polica-flow" name="Batch flow">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1850" pageHeight="912" background="#ffffff" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="title" value="&lt;b&gt;Polica · Medication batch lifecycle&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#4B5563;&quot;&gt;Flow for issue #3. Each step is one issue; the color shows who acts. A batch near expiry is transferred where it sells, or written off with approval.&lt;/span&gt;" style="text;html=1;fontSize=24;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="50" y="22" width="1500" height="64" as="geometry"/></mxCell>
<mxCell id="po" value="&lt;b style=&quot;font-size:14px&quot;&gt;Create and send purchase order&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#2563EB;font-weight:600&quot;&gt;Manager · #12&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Draft → Sent. Number PO-yyyy-00000 from a SQL sequence.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="150" y="130" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="receive" value="&lt;b style=&quot;font-size:14px&quot;&gt;Receive goods by batch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#059669;font-weight:600&quot;&gt;Pharmacist · #13&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Lot, expiry, quantity, unit cost. Short shelf life is rejected; a partial receipt keeps the PO open.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="490" y="130" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="stock" value="&lt;b style=&quot;font-size:14px&quot;&gt;Stock overview&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#059669;font-weight:600&quot;&gt;Pharmacist, Manager · #14&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Every batch on the shelf with days left to expiry.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="dispense" value="&lt;b style=&quot;font-size:14px&quot;&gt;Dispense by FEFO&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#059669;font-weight:600&quot;&gt;Pharmacist · #15&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;System takes the earliest expiry first. Expired and recalled batches are blocked.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1170" y="130" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="job" value="&lt;b style=&quot;font-size:14px&quot;&gt;Daily expiry check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#7C3AED;font-weight:600&quot;&gt;System, background job · #16&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Alert at the First or Second threshold, or Expired. Badge in the header.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1510" y="130" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="review" value="&lt;b style=&quot;font-size:14px&quot;&gt;Handle critical batch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#2563EB;font-weight:600&quot;&gt;Manager · #17&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;System suggests pharmacies by consumption over the last N days.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1510" y="330" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="request" value="&lt;b style=&quot;font-size:14px&quot;&gt;Request transfer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#2563EB;font-weight:600&quot;&gt;Manager · #18&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Batch, quantity, destination, reason.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1170" y="530" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="approve" value="&lt;b style=&quot;font-size:14px&quot;&gt;Approve or reject transfer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#D97706;font-weight:600&quot;&gt;Destination manager · #18&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;If rejected: choose another pharmacy or write off.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="830" y="530" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="ship" value="&lt;b style=&quot;font-size:14px&quot;&gt;Ship transfer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#059669;font-weight:600&quot;&gt;Pharmacist · #19&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Source stock decreases at shipping, so FEFO cannot allocate packs in transit.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="830" y="330" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="recv" value="&lt;b style=&quot;font-size:14px&quot;&gt;Receive transfer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#D97706;font-weight:600&quot;&gt;Destination pharmacist · #19&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Destination stock increases. Same Batch row, so lot and expiry are kept.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1170" y="330" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="propose" value="&lt;b style=&quot;font-size:14px&quot;&gt;Propose write-off&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#059669;font-weight:600&quot;&gt;Pharmacist · #20&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Reason, plus a note when the reason requires one.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1510" y="730" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="approvewo" value="&lt;b style=&quot;font-size:14px&quot;&gt;Approve write-off&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#2563EB;font-weight:600&quot;&gt;Manager · #20&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Confirm modal. Stock decreases; loss = quantity × cost at approval.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="1170" y="730" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="dash" value="&lt;b style=&quot;font-size:14px&quot;&gt;Dashboard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#2563EB;font-weight:600&quot;&gt;Manager, Administrator · #21&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11.5px;color:#374151&quot;&gt;Stock value, batches near expiry, write-off loss by month.&lt;/span&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="830" y="730" width="280" height="112" as="geometry"/></mxCell>
<mxCell id="decide" value="&lt;b style=&quot;font-size:13.5px&quot;&gt;Demand in another pharmacy?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2563EB;strokeWidth=1.5;spacing=28;" vertex="1" parent="1"><mxGeometry x="1535.0" y="526.0" width="230" height="120" as="geometry"/></mxCell>
<mxCell id="start" value="" style="ellipse;html=1;fillColor=#111827;strokeColor=#111827;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="57" y="173.0" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="end" value="" style="ellipse;shape=endState;html=1;fillColor=#111827;strokeColor=#111827;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="737" y="773.0" width="26" height="26" as="geometry"/></mxCell>
